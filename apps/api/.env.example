# --- Database (local Docker or Supabase Postgres) ---
DATABASE_URL=postgresql://dukorpay:dukorpay_dev@localhost:5432/dukorpay
# For Supabase: use the pooler URL (often port 6543) with ?pgbouncer=true for the app.
# For Prisma migrations against Supabase, add a direct (non-pooler) URL — see README.
REDIS_URL=redis://localhost:6379

# Legacy JWT (used when Supabase Auth env is not fully set, and for some tooling)
JWT_SECRET=dev-jwt-secret-change-me-in-production-xx

PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- Supabase (optional — when all three are set, Auth uses GoTrue + JWTs) ---
# Project Settings → API: Project URL, anon public, service_role (server only).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional seed
SEED_ADMIN_EMAIL=admin@dukorpay.local
SEED_ADMIN_PASSWORD=admin-admin-admin
