{
  "expo": {
    "name": "Lizor",
    "slug": "rapid",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "rapid",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rapid.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Lizor uses your location to find nearby drivers and set your pickup point."
      }
    },
    "android": {
      "package": "com.rapid.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a1630"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/lizor-mark.png"
    },
    "extra": {
      "apiUrl": "http://localhost:4000"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lizor uses your location to find nearby drivers and set your pickup point."
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/lizor-mark.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a1630"
    }
  }
}
