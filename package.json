{
  "name": "dukorpay",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/api",
    "apps/mobile",
    "apps/admin"
  ],
  "scripts": {
    "api:dev": "npm run dev -w apps/api",
    "api:db:generate": "npm run db:generate -w apps/api",
    "api:db:migrate": "npm run db:migrate -w apps/api",
    "api:db:seed": "npm run db:seed -w apps/api",
    "mobile:start": "npm run start -w apps/mobile",
    "admin:dev": "npm run dev -w apps/admin",
    "admin:vercel:link": "vercel link --cwd apps/admin",
    "admin:vercel": "vercel --cwd apps/admin",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "build": "npm run build -w apps/admin"
  },
  "engines": {
    "node": ">=20"
  }
}
